# ──────────────────────────────────────────
# Django core
# ──────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_TIME_ZONE=Asia/Kathmandu

# Comma-separated hosts
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.trycloudflare.com

# Comma-separated origins with scheme
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# Set to 1 when using Cloudflare / reverse proxy HTTPS
DJANGO_TRUST_X_FORWARDED_PROTO=1

# Public base URL used during QR/public testing
PUBLIC_BASE_URL=https://your-current-quick-tunnel.trycloudflare.com

# ──────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────
DB_NAME=preventab
DB_USER=preventab_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# ──────────────────────────────────────────
# Email
# ──────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=PreventaB <your_email@example.com>

# ──────────────────────────────────────────
# Agent / ingest
# ──────────────────────────────────────────
AGENT_INGEST_TOKEN=replace-with-a-strong-ingest-token

# ──────────────────────────────────────────
# ML artifact paths
# ──────────────────────────────────────────
ML_ARTIFACT_DIR=ml_artifacts
ML_MODEL_PATH=ml_artifacts/model.joblib
ML_FEATURES_PATH=ml_artifacts/features.json
ML_METADATA_PATH=ml_artifacts/model_metadata.json
ML_ACTION_MAP_PATH=ml_artifacts/action_map.json
ML_KAGGLE_INSIGHTS_PATH=ml_artifacts/kaggle_insights.json

# ──────────────────────────────────────────
# Optional demo overrides
# ──────────────────────────────────────────
DEMO_DEVICE_NAME=My Demo Device
DEMO_DEVICE_IP=127.0.0.1
