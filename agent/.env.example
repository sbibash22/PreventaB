# URL of the Django server ingest endpoint base
# Same Wi-Fi example:
# SERVER_URL=http://192.168.1.100:8000
#
# Cloudflare Quick Tunnel example:
# SERVER_URL=https://your-current-quick-tunnel.trycloudflare.com
SERVER_URL=http://192.168.1.100:8000

# Copy this API key from the Device detail page in Django admin/app
DEVICE_API_KEY=replace-with-device-api-key

# Must match AGENT_INGEST_TOKEN in the Django server .env
AGENT_INGEST_TOKEN=replace-with-the-same-ingest-token

# Seconds between sends
INTERVAL_SECONDS=60

# Number of log events to send each cycle
MAX_EVENTS=10

# Optional request timeout
REQUEST_TIMEOUT_SECONDS=15

# Optional: 1 to verify HTTPS certs, 0 only for local troubleshooting
VERIFY_TLS=1
